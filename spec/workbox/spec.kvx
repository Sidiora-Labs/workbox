verify_cmd = "node scripts/check-tests.mjs && node --test packages/core/test/integration/seccomp.test.js"
do_1       = "seccomp.js assembles a classic BPF program for x86_64: validate arch, deny the x32 ABI, return EPERM for the denylist, allow otherwise; the program is passed to bwrap --seccomp through an inherited fd."
do_2       = "Tests: denied syscalls fail with EPERM inside a real sandbox, apt-style operations (fork, exec, chown, setuid, socket, epoll, io_uring absent) still work, and the filter is reported in /proc/self/status."
reqs       = ["1.6"]

