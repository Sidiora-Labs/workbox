verify_cmd = "node scripts/check-tests.mjs && node --test packages/core/test/integration/broker.test.js"
do_1       = "Asks: raise with kind and payload, status, list, wait with timeout; answers through the manager API; channel plugins stdout and webhook; audit."
do_2       = "Secrets: host-side provider reading a 0600 JSON file or environment; per-sandbox policy of allowed refs; secret exec resolves refs and the runner injects them only into the child env; redaction of registered values in spool and audit."
do_3       = "Events with sequence and causation; leases issued per sandbox with TTL, renew and status including the derived offline deadline; checkpoints as tar of upper plus envelope JSON with digest, list and restore into a new sandbox; artifact put via outbox, get and list."
do_4       = "Tests exercise each command inside a real sandbox and assert the negative cases: refused ref, value absent from store, audit and spool, second nonce refused, lease expiry."
