{
  "post": {
    "operationId": "sendSessionInput",
    "summary": "Write to session stdin",
    "description": "Write base64 `data` or UTF-8 `text` (not both) to the session stdin; `eof` closes it.\n\nScope: `exec`.",
    "tags": ["sessions"],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Sandbox id.",
        "schema": { "type": "string", "minLength": 1 }
      },
      {
        "name": "sessionId",
        "in": "path",
        "required": true,
        "description": "Session id.",
        "schema": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    ],
    "requestBody": {
      "required": false,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "data": {
                "type": "string",
                "maxLength": 6291456,
                "pattern": "^[A-Za-z0-9+/]*={0,2}$",
                "contentEncoding": "base64",
                "description": "Base64-encoded bytes."
              },
              "text": { "type": "string", "maxLength": 4194304 },
              "eof": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "The runner acknowledgement.",
        "content": { "application/json": {} }
      },
      "400": {
        "$ref": "../openapi.json#/components/responses/Error",
        "description": "An invalid body or query (`E_INVALID_PARAMS`) naming the first path."
      },
      "401": {
        "$ref": "../openapi.json#/components/responses/Error",
        "description": "A missing or invalid bearer token (`E_DENIED`)."
      },
      "403": {
        "$ref": "../openapi.json#/components/responses/Error",
        "description": "The key lacks the scope, or a browser-originated request or foreign Host (`E_DENIED`)."
      },
      "404": {
        "$ref": "../openapi.json#/components/responses/Error",
        "description": "No such resource, or one the key does not see."
      },
      "429": {
        "$ref": "../openapi.json#/components/responses/Error",
        "description": "Too many failed authentications from this address (`E_LIMIT`); see `Retry-After`."
      },
      "default": {
        "$ref": "../openapi.json#/components/responses/Error",
        "description": "Any other failure; see the error codes."
      }
    },
    "x-workbox-scope": "exec"
  }
}
