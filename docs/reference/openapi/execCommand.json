{
  "post": {
    "operationId": "execCommand",
    "summary": "Run a command to completion",
    "description": "Run `argv` in the sandbox and wait for it to finish. `input` is written to stdin; output beyond `maxOutputBytes` is cut.\n\nScope: `exec`.",
    "tags": ["sandboxes"],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Sandbox id.",
        "schema": { "type": "string", "minLength": 1 }
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "argv": {
                "type": "array",
                "items": { "type": "string", "minLength": 1, "maxLength": 65536 },
                "minItems": 1,
                "maxItems": 4096
              },
              "cwd": { "type": "string", "minLength": 1, "maxLength": 4096 },
              "env": { "type": "object", "additionalProperties": { "type": "string" } },
              "input": { "type": "string" },
              "name": { "type": "string", "minLength": 1, "maxLength": 128 },
              "uid": { "type": "integer", "minimum": 0, "maximum": 65535 },
              "gid": { "type": "integer", "minimum": 0, "maximum": 65535 },
              "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 86400000 },
              "graceMs": { "type": "integer", "minimum": 0, "maximum": 600000 },
              "maxOutputBytes": { "type": "integer", "minimum": 0, "maximum": 67108864 }
            },
            "required": ["argv"],
            "additionalProperties": false
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "The exit code and the captured stdout and stderr.",
        "content": { "application/json": {} }
      },
      "400": {
        "$ref": "../openapi.json#/components/responses/Error",
        "description": "An invalid body or query (`E_INVALID_PARAMS`) naming the first path."
      },
      "401": {
        "$ref": "../openapi.json#/components/responses/Error",
        "description": "A missing or invalid bearer token (`E_DENIED`)."
      },
      "403": {
        "$ref": "../openapi.json#/components/responses/Error",
        "description": "The key lacks the scope, or a browser-originated request or foreign Host (`E_DENIED`)."
      },
      "404": {
        "$ref": "../openapi.json#/components/responses/Error",
        "description": "No such resource, or one the key does not see."
      },
      "429": {
        "$ref": "../openapi.json#/components/responses/Error",
        "description": "Too many failed authentications from this address (`E_LIMIT`); see `Retry-After`."
      },
      "default": {
        "$ref": "../openapi.json#/components/responses/Error",
        "description": "Any other failure; see the error codes."
      }
    },
    "x-workbox-scope": "exec"
  }
}
