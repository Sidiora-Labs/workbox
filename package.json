{
  "name": "workbox",
  "version": "0.1.0-dev",
  "private": true,
  "description": "CLI-native agent sandbox: bubblewrap + cgroup v2 isolation, an in-box runner, the wb toolkit, and REST/WS, SDK, MCP and CLI surfaces.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "test": "node scripts/check-tests.mjs && node --test \"packages/*/test/**/*.test.js\" \"test/e2e/*.test.js\"",
    "test:coverage": "node scripts/check-tests.mjs && node --test --experimental-test-coverage --test-coverage-include=\"packages/*/src/**/*.js\" --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=90 \"packages/*/test/**/*.test.js\"",
    "check:tests": "node scripts/check-tests.mjs",
    "lint": "eslint .",
    "fmt": "prettier --write \"packages/**/*.{js,json,md}\" \"scripts/*.mjs\" \"*.md\"",
    "fmt:check": "prettier --check \"packages/**/*.{js,json,md}\" \"scripts/*.mjs\""
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "eslint": "9.18.0",
    "eslint-formatter-compact": "9.0.1",
    "prettier": "3.4.2"
  }
}
